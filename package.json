{
	"name": "ats-screener",
	"version": "0.5.1",
	"private": true,
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": "^22.13.0 || >=24.0.0",
		"pnpm": ">=10.0.0"
	},
	"packageManager": "pnpm@10.32.1",
	"scripts": {
		"prepare": "svelte-kit sync || echo ''",
		"dev": "vite dev",
		"build": "svelte-kit sync && pnpm build:docs && vite build",
		"build:docs": "cd docs && pnpm install --frozen-lockfile && pnpm build && cd .. && rm -rf static/docs && cp -r docs/dist static/docs",
		"build:app": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"validate": "pnpm check && pnpm lint && pnpm format:check && pnpm test && pnpm build",
		"gate": "pnpm validate"
	},
	"dependencies": {
		"@number-flow/svelte": "^0.4.2",
		"@vercel/og": "^1.0.1",
		"bits-ui": "^2.19.5",
		"compromise": "^14.18.0",
		"firebase": "^12.19.0",
		"jspdf": "^4.2.1",
		"mammoth": "^1.13.0",
		"pdfjs-dist": "^6.4.299"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.0",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^24.19.1",
		"eslint": "^10.12.0",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.13.0",
		"jsdom": "^29.1.1",
		"open-props": "^1.7.23",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.1",
		"vite": "^8.3.4",
		"vitest": "^5.0.3"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"sharp",
			"workerd"
		],
		"overrides": {
			"rollup@<4.59.0": "^4.59.0"
		}
	},
	"optionalDependencies": {
		"ldapts": "^9.2.0"
	}
}
