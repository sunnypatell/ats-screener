# copy to .env and adjust. docker-compose picks it up automatically.

# deterministic local scoring (no LLM needed). set to "false" to prefer the
# LLM scoring chain with a provider key below.
PUBLIC_DETERMINISTIC_ONLY=true

# self-hosted OCR (Tesseract por+eng + Poppler), bundled in the image
OCR_ENABLED=true

# optional LLM provider keys for the LLM scoring chain
# CEREBRAS_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3

# session signing secret for LDAP sign-in: openssl rand -hex 32
# SESSION_SECRET=
